# Dify instance
DIFY_API_BASE=https://cloud.dify.ai
# DIFY_WORKSPACE_ID=

# Console authoring (cookie + CSRF). Prefer this over a console Bearer token.
# Cookie header, cookie-editor JSON, or {cookies:[{name,value},...]}.
# DIFY_CONSOLE_COOKIE=

# Optional OpenAPI device/management token (list/run/export fallback)
# DIFY_OPENAPI_TOKEN=

# Optional console login (difywf auth login-console)
# DIFY_CONSOLE_EMAIL=
# DIFY_CONSOLE_PASSWORD=
# DIFY_CONSOLE_PASSWORD_ENCODING=plain

# Config + audit directory (default ~/.difywf). Set in tests/containers.
# DIFYWF_HOME=

# macOS keychain for hosts.json secrets (default on when DIFYWF_HOME is unset)
# DIFYWF_KEYCHAIN=0

# Streamable HTTP MCP
# DIFYWF_MCP_TRANSPORT=http
# DIFYWF_MCP_HOST=127.0.0.1
# DIFYWF_MCP_PORT=3000
# Required when binding a non-loopback address:
# DIFYWF_MCP_TOKEN=
# DIFYWF_MCP_ALLOWED_HOSTS=
# DIFYWF_MCP_MAX_BODY_BYTES=2097152

# Timeouts
# DIFYWF_HTTP_TIMEOUT_MS=60000
# DIFYWF_SSE_TIMEOUT_MS=300000

# Graph policies
# DIFYWF_CODE_NODES=confirm
# DIFYWF_ALLOW_PRIVATE_URL=0
